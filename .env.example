# ─── Database ────────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── KRA eTIMS (simulator defaults — set live values in Settings UI) ──
KRA_PIN=P051234567A
KRA_BRANCH_ID=00
KRA_DEVICE_SERIAL=KRA-DEVICE-001
KRA_CALLBACK_URL=https://api.dukaflow.co.ke/etims/callback

# ─── M-Pesa Daraja ───────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_TILL_NUMBERS=123456, 654321
MPESA_CALLBACK_URL=https://api.dukaflow.co.ke/mpesa/callback

# ─── Africa's Talking SMS / WhatsApp Cloud API ───────────────
SMS_PROVIDER=africastalking
SMS_API_KEY=your-at-api-key
SMS_SENDER_NAME=DUKAFLOW
WHATSAPP_TOKEN=your-whatsapp-cloud-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
