// DukaFlow — Kenya Retail ERP + POS
// Prisma schema (SQLite). All money values are KES.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Org structure ────────────────────────────────────────────────────────────

model Store {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  location  String
  isMain    Boolean      @default(false)
  createdAt DateTime     @default(now())
  stocks    StockLevel[]
  sales     Sale[]
  staff     Staff[]
  tillSessions TillSession[]
  purchaseOrders PurchaseOrder[]
  expenses  Expense[]
  salesReturns SalesReturn[]
}

model Staff {
  id      Int     @id @default(autoincrement())
  name    String
  role    String // Cashier | Store Keeper | Sales | Manager | Owner | Accountant
  pin     String // 4-digit POS login PIN (demo: stored plain)
  color   String  @default("#0052CC")
  onShift Boolean @default(false)
  storeId Int?
  store   Store?  @relation(fields: [storeId], references: [id])
}

// ─── Customers / loyalty / credit ────────────────────────────────────────────

model Customer {
  id              Int        @id @default(autoincrement())
  name            String
  phone           String     @unique
  email           String?
  tier            String     @default("Bronze") // Gold | Silver | Bronze
  loyaltyPoints   Int        @default(0)
  totalSpent      Float      @default(0)
  debtBalance     Float      @default(0)
  creditLimit     Float      @default(0)
  giftCardBalance Float      @default(0)
  birthday        DateTime?
  lastVisit       String?
  storeId         Int?
  notes           String?
  createdAt       DateTime   @default(now())
  sales           Sale[]
  debtPlans       DebtPlan[]
  debtPayments    DebtPayment[]
  giftCards       GiftCard[]
  smsLogs         SmsLog[]
  salesReturns    SalesReturn[]
}

// ─── Catalog & multi-store stock ─────────────────────────────────────────────

model Product {
  id        Int          @id @default(autoincrement())
  name      String
  sku       String       @unique
  barcode   String       @unique
  category  String
  price     Float
  cost      Float        @default(0)
  unit      String       @default("pc")
  emoji     String       @default("📦")
  active    Boolean      @default(true)
  stocks    StockLevel[]
  saleItems SaleItem[]
  saleReturnItems SaleReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

model StockLevel {
  id           Int      @id @default(autoincrement())
  productId    Int
  storeId      Int
  qty          Float    @default(0)
  reorderPoint Float    @default(10)
  // When the current batch landed — used by the Stock Aging report.
  // Reset to now() whenever a positive adjustment / transfer marks fresh stock in.
  receivedAt   DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
  store        Store    @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
}

model StockTransfer {
  id          Int      @id @default(autoincrement())
  productId   Int
  fromStoreId Int
  toStoreId   Int
  qty         Float
  status      String   @default("Completed")
  createdAt   DateTime @default(now())
}

// ─── Till sessions (X/Z reports — cash-drawer shift reconciliation) ─────────

model TillSession {
  id           Int       @id @default(autoincrement())
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  openedBy     String    // staff name
  openingFloat Float     @default(0) // cash in drawer at open
  expectedCash Float? // computed at close: float + cash sales
  countedCash  Float? // physically counted at close
  variance     Float? // counted - expected
  status       String    @default("Open") // Open | Closed
  note         String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
}

// ─── Sales (POS receipts + invoices) ─────────────────────────────────────────

model Sale {
  id              Int        @id @default(autoincrement())
  receiptNo       String     @unique
  storeId         Int
  customerId      Int?
  staffName       String     @default("Counter 1")
  subtotal        Float
  discount        Float      @default(0)
  vat             Float      @default(0)
  total           Float
  paymentMethod   String // Cash | M-Pesa | Till | Paybill | Gift Card | Credit Sale | Card
  pointsRedeemed  Int        @default(0)
  pointsEarned    Int        @default(0)
  tierAtSale      String?
  promoCode       String?
  status          String     @default("Completed")
  kraStatus       String     @default("Pending") // Verified | Pending | Failed
  cuInvoiceNumber String?
  qrCodeBase64    String?
  offlineCreated  Boolean    @default(false)
  clientId        String? // offline queue dedupe key
  syncedAt        DateTime?
  createdAt       DateTime   @default(now())
  items           SaleItem[]
  returns         SalesReturn[]
  store           Store      @relation(fields: [storeId], references: [id])
  customer        Customer?  @relation(fields: [customerId], references: [id])

  @@unique([clientId])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int?
  name      String
  emoji     String   @default("📦")
  qty       Float
  unitPrice Float
  discount  Float    @default(0)
  total     Float
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

// ─── Sales returns & refunds (credit notes, restock, till impact) ────────────

// A return references the original receipt; qty per line is validated against
// what has ALREADY been returned so the same item can never be refunded twice.
model SalesReturn {
  id           Int       @id @default(autoincrement())
  returnNo     String    @unique // RET-0001
  saleId       Int
  sale         Sale      @relation(fields: [saleId], references: [id])
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id])
  staffName    String    @default("Counter 1")
  reason       String    @default("") // Damaged | Wrong item | Customer changed mind | Expired | Other
  refundMethod String    @default("Cash refund") // Cash refund | M-Pesa B2C | Credit note | Gift card
  restocked    Boolean   @default(true)
  total        Float     // refund value incl. VAT
  creditNoteNo String? // CN-0001 when refundMethod = Credit note
  giftCardCode String? // GC-xxxx when refundMethod = Gift card (store credit)
  status       String    @default("Completed")
  createdAt    DateTime  @default(now())
  items        SaleReturnItem[]
}

model SaleReturnItem {
  id        Int          @id @default(autoincrement())
  returnId  Int
  returnRef SalesReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId Int? // line on the original receipt
  productId Int?
  name      String
  emoji     String       @default("📦")
  qty       Float
  unitPrice Float
  total     Float
  product   Product?     @relation(fields: [productId], references: [id])
}

// ─── Procurement: suppliers & purchase orders (reorder → receive) ────────────

model Supplier {
  id       Int    @id @default(autoincrement())
  name     String
  phone    String @default("")
  email    String @default("")
  kraPin   String @default("")
  category String @default("General") // Cement | Paint | Plumbing | Tools | General
  leadDays Int    @default(3)
  active   Boolean @default(true)
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         Int       @id @default(autoincrement())
  poNo       String    @unique // PO-0001
  supplierId Int
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  status     String    @default("Draft") // Draft | Sent | Received | Cancelled
  total      Float     @default(0)
  note       String    @default("")
  orderedAt  DateTime  @default(now())
  receivedAt DateTime?
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id        Int      @id @default(autoincrement())
  poId      Int
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  qty       Float
  unitCost  Float
  received  Float    @default(0)
}

// ─── Operating expenses (petty cash / bills) ──────────────────────────────────

model Expense {
  id        Int      @id @default(autoincrement())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  category  String   @default("Other") // Rent | Electricity | Salaries | Transport | Supplies | Marketing | Repairs | Other
  note      String   @default("")
  amount    Float
  paidVia   String   @default("Cash") // Cash | M-Pesa | Bank
  refNo     String?  // receipt / voucher ref
  staffName String   @default("Owner")
  spentAt   DateTime @default(now())
}

model PipelineDeal {
  id            String   @id @default(cuid())
  stage         String   @default("quotation") // quotation|proforma|order|invoiced|paid
  customerName  String
  customerPhone String?
  title         String   @default("")
  amount        Float
  itemCount     Int      @default(1)
  assignee      String   @default("M")
  notes         String?
  history       String   @default("[]") // JSON [{stage, at, by}]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Gift cards & debt plans ─────────────────────────────────────────────────

model GiftCard {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  balance        Float
  initialBalance Float
  customerId     Int?
  expiry         DateTime?
  status         String    @default("Active") // Active | Empty | Expired
  gradient       String    @default("blue")
  createdAt      DateTime  @default(now())
  customer       Customer? @relation(fields: [customerId], references: [id])
}

model DebtPlan {
  id                  Int      @id @default(autoincrement())
  customerId          Int
  invoiceNo           String?
  totalDebt           Float
  installmentType     String   @default("Weekly") // Weekly | Monthly
  installmentAmount   Float
  nextDueDate         DateTime
  status              String   @default("Active") // Active | Completed | Defaulted
  autoReminderSms     Boolean  @default(true)
  autoBlockPosOverdue Boolean  @default(true)
  overdueDays         Int      @default(0)
  customer            Customer @relation(fields: [customerId], references: [id])
  payments            DebtPayment[]
  createdAt           DateTime @default(now())
}

// Payment ledger for debt plans — every installment recorded against a plan
// lands here so the debtor statement can list invoices vs receipts truthfully.
model DebtPayment {
  id         Int      @id @default(autoincrement())
  debtPlanId Int
  plan       DebtPlan @relation(fields: [debtPlanId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("Cash") // Cash | M-Pesa | Bank | Cheque
  note       String?
  createdAt  DateTime @default(now())
}

// ─── HR & Kenya payroll ──────────────────────────────────────────────────────

model Employee {
  id             Int       @id @default(autoincrement())
  name           String
  idNo           String
  dept           String
  role           String
  basic          Float
  houseAllowance Float     @default(0)
  transport      Float     @default(0)
  helb           Float     @default(0)
  bankAccount    String?
  mpesaNumber    String?
  active         Boolean   @default(true)
  payslips       Payslip[]
}

model Payslip {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  period         String // "2026-09"
  basic          Float
  houseAllowance Float
  transport      Float
  overtime       Float    @default(0)
  gross          Float
  nssf           Float
  shif           Float
  housingLevy    Float
  paye           Float
  helb           Float    @default(0)
  net            Float
  status         String   @default("Draft") // Draft | Paid
  employee       Employee @relation(fields: [employeeId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([employeeId, period])
}

// ─── Raven chat ──────────────────────────────────────────────────────────────

model ChatChannel {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  unread      Int           @default(0)
  members     Int           @default(0)
  messages    ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  channelId Int
  author    String
  initials  String
  content   String
  docLink   String? // JSON ERP doc card {title, sub, kind}
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id])
}

// ─── Messaging (Africa's Talking / WhatsApp Cloud API) ───────────────────────

model SmsLog {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  phone      String
  message    String
  channel    String    @default("SMS") // SMS | WhatsApp
  type       String    @default("Promo") // Receipt | DebtReminder | Birthday | Promo | Blast
  status     String    @default("Delivered")
  cost       Float     @default(0)
  createdAt  DateTime  @default(now())
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String    @default("percent") // percent | flat
  value     Float
  active    Boolean   @default(true)
  minSpend  Float     @default(0)
  expiresAt DateTime?
}

// ─── Singleton settings ──────────────────────────────────────────────────────

model Settings {
  id                    Int       @id @default(1)
  kraPin                String    @default("P051234567A")
  kraBranchId           String    @default("00")
  kraDeviceSerial       String    @default("KRA-DEVICE-001")
  kraCallbackUrl        String    @default("https://api.dukaflow.co.ke/etims/callback")
  kraConnected          Boolean   @default(true)
  kraLastSync           DateTime?
  mpesaEnvironment      String    @default("Sandbox") // Sandbox | Production (Daraja app type)
  mpesaConsumerKey      String    @default("demo-consumer-key")
  mpesaConsumerSecret   String    @default("demo-consumer-secret")
  mpesaTillNumbers      String    @default("123456, 654321")
  mpesaCallbackUrl      String    @default("https://api.dukaflow.co.ke/mpesa/callback")
  smsApiKey             String    @default("atsk_demo_1234567890")
  smsSenderName         String    @default("DUKAFLOW")
  loyaltyEarnPerKes     Int       @default(100)
  loyaltyPointValue     Float     @default(1)
  loyaltyExpiryMonths   Int       @default(12)
  vatRate               Float     @default(0.16)
  // Happy Hour auto-pricing: % off the configured category while the window runs.
  happyHourEnabled      Boolean   @default(true)
  happyHourStart        String    @default("14:00") // HH:mm (24h, Africa/Nairobi till time)
  happyHourEnd          String    @default("16:00")
  happyHourPercent      Float     @default(10)
  happyHourCategory     String    @default("All") // "All" or a product category name
  receiptPromoFooter    String    @default("Thank You! You saved KES 300 with points! Come again!")
  receiptPrimaryColor   String    @default("#0052CC")
  receiptSecondaryColor String    @default("#00C853")
  companyName           String    @default("DukaFlow Ltd")
  tierRules             String    @default("{\"bronze\":{\"minPoints\":0,\"discount\":0},\"silver\":{\"minPoints\":500,\"discount\":5},\"gold\":{\"minPoints\":2000,\"discount\":10},\"expiryMonths\":12,\"expiryEnabled\":true}")
  lastDailyJobsAt       DateTime?
  // Scheduled report email ("Schedule email" on Reports) — a mock mailer that logs to SmsLog with channel=Email
  reportScheduleEnabled   Boolean   @default(false)
  reportScheduleFrequency String    @default("Weekly") // Daily | Weekly | Monthly (sent 08:00 EAT by /api/cron/report)
  reportScheduleEmail     String    @default("owner@dukaflow.co.ke")
  reportScheduleLastSentAt DateTime?
  updatedAt             DateTime  @updatedAt
}
