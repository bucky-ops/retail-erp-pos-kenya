// DukaFlow - Kenya Retail ERP + POS
// Prisma schema (SQLite). All money values are KES.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Org structure ------------------------------------------------------------

model Store {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  location        String
  isMain          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  stocks          StockLevel[]
  sales           Sale[]
  staff           Staff[]
  tillSessions    TillSession[]
  purchaseOrders  PurchaseOrder[]
  expenses        Expense[]
  salesReturns    SalesReturn[]
  stockTakes      StockTake[]
  supplierReturns SupplierReturn[]
  employees       Employee[]
  dayCloses       DayClose[]
}

model Staff {
  id      Int     @id @default(autoincrement())
  archivedAt       DateTime?
  name    String
  role    String // Cashier | Store Keeper | Sales | Manager | Owner | Accountant
  pin     String // 4-digit POS login PIN (demo: stored plain)
  color   String  @default("#0052CC")
  onShift Boolean @default(false)
  storeId Int?
  store   Store?  @relation(fields: [storeId], references: [id])
}

// --- Customers / loyalty / credit --------------------------------------------

model Customer {
  id              Int           @id @default(autoincrement())
  archivedAt       DateTime?
  name            String
  phone           String        @unique
  email           String?
  tier            String        @default("Bronze") // Gold | Silver | Bronze
  loyaltyPoints   Int           @default(0)
  totalSpent      Float         @default(0)
  debtBalance     Float         @default(0)
  creditLimit     Float         @default(0)
  giftCardBalance Float         @default(0)
  birthday        DateTime?
  lastVisit       String?
  storeId         Int?
  notes           String?
  createdAt       DateTime      @default(now())
  sales           Sale[]
  debtPlans       DebtPlan[]
  debtPayments    DebtPayment[]
  giftCards       GiftCard[]
  smsLogs         SmsLog[]
  salesReturns    SalesReturn[]
}

// --- Catalog & multi-store stock ---------------------------------------------

model Product {
  id                  Int                  @id @default(autoincrement())
  archivedAt       DateTime?
  name                String
  sku                 String               @unique
  barcode             String               @unique
  category            String
  price               Float
  cost                Float                @default(0)
  unit                String               @default("pc")
  emoji               String               @default("📦")
  active              Boolean              @default(true)
  isScale             Boolean              @default(false) // weight scale item (bananas 1.25kg x price)
  scaleCode           String?              @unique // 5 digit code embedded in EAN-13 scale barcodes (2XXXXXWWWWWC)
  stocks              StockLevel[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  stockTakeItems      StockTakeItem[]
  supplierReturnItems SupplierReturnItem[]
  supplierPrices      SupplierPrice[]
}

model StockLevel {
  id           Int      @id @default(autoincrement())
  productId    Int
  storeId      Int
  qty          Float    @default(0)
  reorderPoint Float    @default(10)
  // When the current batch landed - used by the Stock Aging report.
  // Reset to now() whenever a positive adjustment / transfer marks fresh stock in.
  receivedAt   DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
  store        Store    @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
}

model StockTransfer {
  id          Int      @id @default(autoincrement())
  productId   Int
  fromStoreId Int
  toStoreId   Int
  qty         Float
  status      String   @default("Completed")
  createdAt   DateTime @default(now())
}

// --- Till sessions (X/Z reports - cash-drawer shift reconciliation) ---------

model TillSession {
  id           Int       @id @default(autoincrement())
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  openedBy     String // staff name
  openingFloat Float     @default(0) // cash in drawer at open
  expectedCash Float? // computed at close: float + cash sales
  countedCash  Float? // physically counted at close
  variance     Float? // counted - expected
  status       String    @default("Open") // Open | Closed
  note         String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
}

// --- Sales (POS receipts + invoices) -----------------------------------------

model Sale {
  id              Int           @id @default(autoincrement())
  receiptNo       String        @unique
  storeId         Int
  customerId      Int?
  staffName       String        @default("Counter 1")
  subtotal        Float
  discount        Float         @default(0)
  vat             Float         @default(0)
  total           Float
  paymentMethod   String // Cash | M-Pesa | Till | Paybill | Gift Card | Credit Sale | Card
  pointsRedeemed  Int           @default(0)
  pointsEarned    Int           @default(0)
  tierAtSale      String?
  promoCode       String?
  status          String        @default("Completed")
  kraStatus       String        @default("Pending") // Verified | Pending | Failed
  cuInvoiceNumber String?
  qrCodeBase64    String?
  digitalCode     String? // NVS-DUKA-YYYY-XXXXX digital receipt link
  paySplitsJson   String        @default("[]") // multi-pay split [{method, amount, ref}]
  offlineCreated  Boolean       @default(false)
  clientId        String? // offline queue dedupe key
  syncedAt        DateTime?
  createdAt       DateTime      @default(now())
  items           SaleItem[]
  returns         SalesReturn[]
  store           Store         @relation(fields: [storeId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])

  @@unique([clientId])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int?
  name      String
  emoji     String   @default("📦")
  qty       Float
  unitPrice Float
  discount  Float    @default(0)
  total     Float
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

// --- Sales returns & refunds (credit notes, restock, till impact) ------------

// A return references the original receipt; qty per line is validated against
// what has ALREADY been returned so the same item can never be refunded twice.
model SalesReturn {
  id           Int              @id @default(autoincrement())
  returnNo     String           @unique // RET-0001
  saleId       Int
  sale         Sale             @relation(fields: [saleId], references: [id])
  storeId      Int
  store        Store            @relation(fields: [storeId], references: [id])
  customerId   Int?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  staffName    String           @default("Counter 1")
  reason       String           @default("") // Damaged | Wrong item | Customer changed mind | Expired | Other
  refundMethod String           @default("Cash refund") // Cash refund | M-Pesa B2C | Credit note | Gift card
  restocked    Boolean          @default(true)
  total        Float // refund value incl. VAT
  creditNoteNo String? // CN-0001 when refundMethod = Credit note
  giftCardCode String? // GC-xxxx when refundMethod = Gift card (store credit)
  status       String           @default("Completed")
  createdAt    DateTime         @default(now())
  items        SaleReturnItem[]
}

model SaleReturnItem {
  id         Int         @id @default(autoincrement())
  returnId   Int
  returnRef  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId Int? // line on the original receipt
  productId  Int?
  name       String
  emoji      String      @default("📦")
  qty        Float
  unitPrice  Float
  total      Float
  product    Product?    @relation(fields: [productId], references: [id])
}

// --- Procurement: suppliers & purchase orders (reorder → receive) ------------

model Supplier {
  id              Int              @id @default(autoincrement())
  archivedAt       DateTime?
  name            String
  phone           String           @default("")
  email           String           @default("")
  kraPin          String           @default("")
  category        String           @default("General") // Cement | Paint | Plumbing | Tools | General
  leadDays        Int              @default(3)
  active          Boolean          @default(true)
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]
  prices          SupplierPrice[]
}

/// Negotiated per-product cost from a supplier's price list. When present it
/// overrides Product.cost on reorder suggestions and new PO lines, so buyers
/// always quote the real negotiated price for that supplier.
model SupplierPrice {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cost       Float
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, productId])
}

model PurchaseOrder {
  id         Int                 @id @default(autoincrement())
  poNo       String              @unique // PO-0001
  supplierId Int
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  storeId    Int
  store      Store               @relation(fields: [storeId], references: [id])
  status     String              @default("Draft") // Draft | Sent | Received | Cancelled
  total      Float               @default(0)
  note       String              @default("")
  orderedAt  DateTime            @default(now())
  receivedAt DateTime?
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id        Int           @id @default(autoincrement())
  poId      Int
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId Int
  product   Product       @relation(fields: [productId], references: [id])
  qty       Float
  unitCost  Float
  received  Float         @default(0)
}

// --- Operating expenses (petty cash / bills) ----------------------------------

model Expense {
  id        Int      @id @default(autoincrement())
  archivedAt       DateTime?
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  category  String   @default("Other") // Rent | Electricity | Salaries | Transport | Supplies | Marketing | Repairs | Other
  note      String   @default("")
  amount    Float
  paidVia   String   @default("Cash") // Cash | M-Pesa | Bank
  refNo     String? // receipt / voucher ref
  staffName String   @default("Owner")
  spentAt   DateTime @default(now())
}

model PipelineDeal {
  id            String   @id @default(cuid())
  stage         String   @default("quotation") // quotation|proforma|order|invoiced|paid
  customerName  String
  customerPhone String?
  title         String   @default("")
  amount        Float
  itemCount     Int      @default(1)
  assignee      String   @default("M")
  notes         String?
  history       String   @default("[]") // JSON [{stage, at, by}]
  docsJson      String   @default("{}") // matured chain docs {quotation, proforma, order, invoice, payment} each {no, digitalCode, at}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- Gift cards & debt plans -------------------------------------------------

model GiftCard {
  id             Int       @id @default(autoincrement())
  archivedAt       DateTime?
  code           String    @unique
  balance        Float
  initialBalance Float
  customerId     Int?
  expiry         DateTime?
  status         String    @default("Active") // Active | Empty | Expired
  gradient       String    @default("blue")
  createdAt      DateTime  @default(now())
  customer       Customer? @relation(fields: [customerId], references: [id])
}

model DebtPlan {
  id                  Int           @id @default(autoincrement())
  customerId          Int
  invoiceNo           String?
  totalDebt           Float
  installmentType     String        @default("Weekly") // Weekly | Monthly
  installmentAmount   Float
  nextDueDate         DateTime
  status              String        @default("Active") // Active | Completed | Defaulted
  autoReminderSms     Boolean       @default(true)
  autoBlockPosOverdue Boolean       @default(true)
  overdueDays         Int           @default(0)
  customer            Customer      @relation(fields: [customerId], references: [id])
  payments            DebtPayment[]
  createdAt           DateTime      @default(now())
}

// Payment ledger for debt plans - every installment recorded against a plan
// lands here so the debtor statement can list invoices vs receipts truthfully.
model DebtPayment {
  id         Int      @id @default(autoincrement())
  debtPlanId Int
  plan       DebtPlan @relation(fields: [debtPlanId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("Cash") // Cash | M-Pesa | Bank | Cheque
  note       String?
  createdAt  DateTime @default(now())
}

// --- HR & Kenya payroll ------------------------------------------------------

model Payslip {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  period         String // "2026-09"
  basic          Float
  houseAllowance Float
  transport      Float
  overtime       Float    @default(0)
  gross          Float
  nssf           Float
  shif           Float
  housingLevy    Float
  paye           Float
  helb           Float    @default(0)
  net            Float
  status         String   @default("Draft") // Draft | Paid
  employee       Employee @relation(fields: [employeeId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([employeeId, period])
}

// --- Raven chat --------------------------------------------------------------

model ChatChannel {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  unread      Int           @default(0)
  members     Int           @default(0)
  messages    ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  channelId Int
  author    String
  initials  String
  content   String
  docLink   String? // JSON ERP doc card {title, sub, kind}
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id])
}

// --- Messaging (Africa's Talking / WhatsApp Cloud API) -----------------------

model SmsLog {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  phone      String
  message    String
  channel    String    @default("SMS") // SMS | WhatsApp
  type       String    @default("Promo") // Receipt | DebtReminder | Birthday | Promo | Blast
  status     String    @default("Delivered")
  cost       Float     @default(0)
  createdAt  DateTime  @default(now())
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  archivedAt       DateTime?
  code      String    @unique
  type      String    @default("percent") // percent | flat
  value     Float
  active    Boolean   @default(true)
  minSpend  Float     @default(0)
  expiresAt DateTime?
}

// --- Singleton settings ------------------------------------------------------

model Settings {
  id                       Int       @id @default(1)
  kraPin                   String    @default("P051234567A")
  kraBranchId              String    @default("00")
  kraDeviceSerial          String    @default("KRA-DEVICE-001")
  kraCallbackUrl           String    @default("https://api.dukaflow.co.ke/etims/callback")
  kraConnected             Boolean   @default(true)
  kraLastSync              DateTime?
  mpesaEnvironment         String    @default("Sandbox") // Sandbox | Production (Daraja app type)
  mpesaConsumerKey         String    @default("demo-consumer-key")
  mpesaConsumerSecret      String    @default("demo-consumer-secret")
  mpesaTillNumbers         String    @default("123456, 654321")
  mpesaCallbackUrl         String    @default("https://api.dukaflow.co.ke/mpesa/callback")
  smsApiKey                String    @default("atsk_demo_1234567890")
  smsSenderName            String    @default("DUKAFLOW")
  loyaltyEarnPerKes        Int       @default(100)
  loyaltyPointValue        Float     @default(1)
  loyaltyExpiryMonths      Int       @default(12)
  vatRate                  Float     @default(0.16)
  // Happy Hour auto-pricing: % off the configured category while the window runs.
  happyHourEnabled         Boolean   @default(true)
  happyHourStart           String    @default("14:00") // HH:mm (24h, Africa/Nairobi till time)
  happyHourEnd             String    @default("16:00")
  happyHourPercent         Float     @default(10)
  happyHourCategory        String    @default("All") // "All" or a product category name
  receiptPromoFooter       String    @default("Thank You! You saved KES 300 with points! Come again!")
  logoUrl                  String    @default("") // company logo (company master) printed on receipts + reports
  companyPhone             String    @default("0712 345 678")
  companyAddress           String    @default("Thika Road Mall, Nairobi")
  tillNo                   String    @default("01")
  receiptFooterMessage     String    @default("Thank you! Sema na sisi: 0712 345 678")
  etimsEnabled             Boolean   @default(true) // KRA eTIMS QR + CU invoice number on receipts
  receiptPrimaryColor      String    @default("#0052CC")
  receiptSecondaryColor    String    @default("#00C853")
  companyName              String    @default("DukaFlow Ltd")
  tierRules                String    @default("{\"bronze\":{\"minPoints\":0,\"discount\":0},\"silver\":{\"minPoints\":500,\"discount\":5},\"gold\":{\"minPoints\":2000,\"discount\":10},\"expiryMonths\":12,\"expiryEnabled\":true}")
  lastDailyJobsAt          DateTime?
  // Scheduled report email ("Schedule email" on Reports) - a mock mailer that logs to SmsLog with channel=Email
  reportScheduleEnabled    Boolean   @default(false)
  reportScheduleFrequency  String    @default("Weekly") // Daily | Weekly | Monthly (sent 08:00 EAT by /api/cron/report)
  reportScheduleEmail      String    @default("owner@dukaflow.co.ke")
  reportScheduleLastSentAt DateTime?
  updatedAt                DateTime  @updatedAt
}

// --- Stock take / cycle count -------------------------------------------------
// A count session snapshots every stock line in a store, the team enters what
// is physically on the shelf, and approving applies the variances as real
// adjustments (with a full audit trail + chat notification).

model StockTake {
  id         Int             @id @default(autoincrement())
  stNo       String          @unique // ST-0001
  storeId    Int
  store      Store           @relation(fields: [storeId], references: [id])
  status     String          @default("Counting") // Counting | Review | Approved | Cancelled
  category   String          @default("All") // scope filter at creation ("All" or a category)
  startedBy  String          @default("Owner")
  note       String          @default("")
  startedAt  DateTime        @default(now())
  approvedAt DateTime?
  items      StockTakeItem[]
}

model StockTakeItem {
  id          Int       @id @default(autoincrement())
  stockTakeId Int
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Float // snapshot of StockLevel.qty when the session opened
  countedQty  Float? // what the team actually found on the shelf
  unitCost    Float     @default(0) // cost at snapshot time - values the variance
  counted     Boolean   @default(false)
  countedAt   DateTime?
  countedBy   String    @default("")
}

// --- Return to vendor (RTV) / debit notes -------------------------------------
// Send damaged / wrong / excess goods back to a supplier with a numbered debit
// note; stock leaves the store and every line is audited in #stock-alerts.

model SupplierReturn {
  id          Int                  @id @default(autoincrement())
  rtnNo       String               @unique // RTV-0001
  debitNoteNo String               @default("") // DN-0001
  supplierId  Int
  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  storeId     Int
  store       Store                @relation(fields: [storeId], references: [id])
  reason      String               @default("Damaged") // Damaged | Wrong item | Warranty | Overstock
  total       Float                @default(0) // valued at cost - what the supplier owes us
  status      String               @default("Sent") // Sent | Credited
  note        String               @default("")
  createdAt   DateTime             @default(now())
  items       SupplierReturnItem[]
}

model SupplierReturnItem {
  id               Int            @id @default(autoincrement())
  supplierReturnId Int
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product        @relation(fields: [productId], references: [id])
  qty              Float
  unitCost         Float
  total            Float
}

// --- HRMS: employee master, attendance & leave --------------------------------
// Full employee records for the Kenya HRMS screen: statutory numbers (KRA PIN,
// NSSF, SHIF, Housing Levy), salary channel (bank / M-Pesa), emergency contact,
// leave balances and a daily attendance register with check-in times.

model Employee {
  id              Int            @id @default(autoincrement())
  archivedAt       DateTime?
  staffNo         String         @unique @default("") // DF-001
  name            String
  idNo            String
  kraPin          String         @default("")
  nssfNo          String         @default("")
  shifNo          String         @default("")
  housingNo       String         @default("") // Housing Levy number
  dept            String
  role            String
  storeId         Int?
  store           Store?         @relation(fields: [storeId], references: [id])
  basic           Float
  houseAllowance  Float          @default(0)
  transport       Float          @default(0)
  helb            Float          @default(0)
  bankAccount     String?
  mpesaNumber     String?
  emergencyName   String         @default("")
  emergencyPhone  String         @default("")
  leaveAnnual     Int            @default(21) // entitled days
  leaveAnnualUsed Int            @default(0)
  leaveSick       Int            @default(7)
  leaveSickUsed   Int            @default(0)
  attendancePct   Float          @default(96) // trailing 30 days
  status          String         @default("Active") // Active | On Leave | Suspended | Exited
  joinedAt        DateTime       @default(now())
  active          Boolean        @default(true)
  payslips        Payslip[]
  attendances     Attendance[]
  advances        StaffAdvance[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        String // "2026-09-18" - day granularity
  status      String   @default("Present") // Present | Late | Absent | Leave | OFF
  checkIn     String? // "08:03"
  checkOut    String? // "17:12"
  overtimeHrs Float    @default(0)

  @@unique([employeeId, date])
}

// Salary advance / loan with installment tracking
model StaffAdvance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ref         String    @default("") // ADV-001
  principal   Float
  installment Float     @default(0) // deducted per payslip
  outstanding Float
  reason      String    @default("")
  takenAt     DateTime  @default(now())
  clearedAt   DateTime?
}

// --- Day closing workflow (Z reports) -----------------------------------------
// Owner closes the till day: count cash + M-Pesa, check variance vs system,
// get manager approval for big variances, then freeze a Z report. Closing a
// day also auto-posts the sales journal into the accounting module.

model DayClose {
  id           Int       @id @default(autoincrement())
  zNo          String    @unique // Z-2026-0918-THIKA
  digitalCode  String? // NVS digital receipt twin of the printed Z
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  businessDate String // "2026-09-18"
  status       String    @default("Open") // Open | Closed
  salesTotal   Float     @default(0)
  receipts     Int       @default(0)
  cashSystem   Float     @default(0)
  cashCounted  Float?
  mpesaSystem  Float     @default(0)
  mpesaCounted Float?
  cardSystem   Float     @default(0)
  paybillSystem Float    @default(0) // M-Pesa Paybill tender
  pointsSystem  Float     @default(0) // Points tender value
  discountsTotal Float    @default(0)
  returnsTotal  Float     @default(0)
  variance     Float     @default(0) // counted - system (cash+mpesa)
  approvedBy   String    @default("")
  staffOnDuty  String    @default("") // comma separated names
  openingCash  Float     @default(0)
  closingCash  Float?
  note         String    @default("")
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
}

// --- Accounting: chart of accounts, journals, bank recon ----------------------
// Simple but complete double-entry ledger. Accounts form a tree (1000 Assets →
// 1010 Cash Thika...). Every day close auto-posts a sales journal. Trial
// balance, P&L and Balance Sheet are computed from JournalLine sums.

model Account {
  id      Int           @id @default(autoincrement())
  code    String        @unique // "1010"
  name    String // "Cash - Thika Road"
  type    String // Asset | Liability | Equity | Revenue | COGS | Expense
  parent  String? // parent account code, null for roots
  isGroup Boolean       @default(false) // group headers cannot be posted to
  balance Float         @default(0) // cached balance (debit-positive)
  lines   JournalLine[]
}

model JournalEntry {
  id        Int           @id @default(autoincrement())
  jvNo      String        @unique // JV-0001
  date      String // "2026-09-18"
  memo      String        @default("")
  source    String        @default("Manual") // Manual | DayClose | Payroll | Inventory
  refNo     String        @default("") // Z-…, PAY-…, PO-…
  storeId   Int?
  createdAt DateTime      @default(now())
  lines     JournalLine[]
}

model JournalLine {
  id        Int          @id @default(autoincrement())
  entryId   Int
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Float        @default(0)
  credit    Float        @default(0)
  memo      String       @default("")
}

// M-Pesa till / bank statement lines used by the reconciliation view
model BankStatementLine {
  id          Int     @id @default(autoincrement())
  date        String
  till        String  @default("M-Pesa Till 123456")
  ref         String // receipt no / paybill ref
  description String
  amount      Float // +money in, -money out
  matched     Boolean @default(false)
  matchRef    String  @default("") // JV-… it reconciles to
}

// --- Settings receipt branding additions are on the Settings model -----------

// --- Supermarket mode: held carts (Naivas style HOLD + resume) ---------------
// A cashier can HOLD a cart with one click, serve the next customer, then
// resume. Holds persist across refresh / module switches / logout because the
// server keeps them (the POS also mirrors them into localStorage).

model PosHold {
  id           Int       @id @default(autoincrement())
  holdCode     String    @unique // HOLD-0001
  staffName    String // which cashier parked the cart
  storeId      Int
  customerId   Int?
  customerName String    @default("")
  label        String    @default("") // e.g. "Basket at counter 2"
  itemsJson    String // JSON [{productId, name, emoji, qty, unitPrice, discount, total, unit}]
  itemCount    Int       @default(0)
  subtotal     Float     @default(0)
  total        Float     @default(0)
  status       String    @default("Held") // Held | Resumed
  createdAt    DateTime  @default(now())
  resumedAt    DateTime?
}

// --- Digital receipts (QR never dies: public verification page) --------------
// Every printable document (sale, Z report, payslip, payment, quotation...)
// gets a public digital twin at /receipt/{receiptCode} - the QR printed on the
// paper receipt points there.

model DigitalReceipt {
  id          Int      @id @default(autoincrement())
  receiptCode String   @unique // NVS-DUKA-YYYY-XXXXX
  uuid        String   @unique @default(uuid()) // obfuscated public lookup
  kind        String   @default("SALE") // SALE | ZREPORT | PAYSLIP | DEBT_PAYMENT | CREDITOR_PAYMENT | QUOTATION | PROFORMA | ORDER | INVOICE | PAYMENT | EXPENSE | STOCK_ADJUSTMENT | JOURNAL | PAYMENT_ENTRY | PURCHASE_INVOICE | EXPENSE_CLAIM | STOCK_ENTRY
  saleId      Int?
  refNo       String   @default("") // source doc number (R-0012, Z-..., JV-...)
  url         String   @default("")
  qrDataUrl   String   @default("")
  payloadJson String   @default("{}") // full document snapshot rendered by /receipt/[code]
  createdAt   DateTime @default(now())
}

// --- Audit log + trash + version history (full CRUD governance) --------------

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String // CREATE | UPDATE | DELETE | RESTORE | LOGIN | MATURE | DAY_CLOSE | LOCK_OVERRIDE
  entity    String // Customer | Product | Sale | ...
  entityId  String   @default("")
  label     String   @default("")
  details   String   @default("") // JSON diff / reason
  storeId   Int?
  createdAt DateTime @default(now())
}

// Soft delete: records move to Trash with a reason, restorable by managers.
model TrashItem {
  id         Int       @id @default(autoincrement())
  entity     String
  entityId   Int
  label      String
  snapshot   String // full row JSON for restore
  reason     String    @default("")
  deletedBy  String    @default("")
  status     String    @default("InTrash") // InTrash | Restored
  createdAt  DateTime  @default(now())
  restoredAt DateTime?
}

// ERPNext style version log: every update records who changed what.
model VersionLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  editor    String
  changes   String // JSON [{field, from, to}]
  createdAt DateTime @default(now())
}
